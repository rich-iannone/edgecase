var d=JSON.parse(raw)}catch(e){return}\n    var h='';\n    for(var k in d){\n      var v=d[k];\n      if(Array.isArray(v)) v=v.join(', ');\n      h+='<div><b>'+k+'</b>: '+v+'</div>';\n    }\n    if(!h) return;\n    tip.innerHTML=h;tip.style.display='block';\n    place(ev);\n  }\n  svg.addEventListener('mouseover',function(ev){\n    var t=ev.target;\n    if(t.hasAttribute('data-node')||t.hasAttribute('data-edge')) show(t,ev);\n  });\n  svg.addEventListener('mousemove',function(ev){\n    if(tip.style.display==='block') place(ev);\n  });\n  svg.addEventListener('mouseout',function(ev){\n    var t=ev.target;\n    if(t.hasAttribute('data-node')||t.hasAttribute('data-edge'))\n      tip.style.display='none';\n  });\n})();\n</script>\n</div></div>\n```\n:::\n:::\n\n\n::: {#d0721e2b .cell execution_count=5}\n``` {.python .cell-code}\nhigh.layout_bipartite().plot(\n    layout=\"pos\", color_by=\"part\", show_labels=False,\n    width=320, height=320, legend=False,\n)\n```\n\n::: {.cell-output .cell-output-display execution_count=5}\n```{=html}\n<div class=\"ec-theme\" style=\"display:contents\"><style class=\"ec-theme-vars\">:where(.ec-theme){--ect-3239c383:#fafafa;--ect-e5dfd507:#94a3b8;--ect-8a2de1d4:#374151;--ect-57425a7e:rgba(15,23,42,0.88);--ect-21ade003:#f1f5f9;--ect-61169ea5:#c2410c}@media (prefers-color-scheme: dark){.ec-theme{--ect-3239c383:#0d1117;--ect-e5dfd507:#4b5563;--ect-8a2de1d4:#d1d5db;--ect-57425a7e:rgba(241,245,249,0.92);--ect-21ade003:#0f172a;--ect-61169ea5:#f97316}}:is(html.quarto-light, body.quarto-light, html[data-bs-theme=\"light\"], [data-jp-theme-light=\"true\"], body.vscode-light, body.vscode-high-contrast-light, html[theme=\"light\"]) .ec-theme{--ect-3239c383:#fafafa;--ect-e5dfd507:#94a3b8;--ect-8a2de1d4:#374151;--ect-57425a7e:rgba(15,23,42,0.88);--ect-21ade003:#f1f5f9;--ect-61169ea5:#c2410c}:is(html.quarto-dark, body.quarto-dark, html[data-bs-theme=\"dark\"], [data-jp-theme-light=\"false\"], body.vscode-dark, body.vscode-high-contrast:not(.vscode-h