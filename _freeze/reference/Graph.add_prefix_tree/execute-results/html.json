ne\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"1-3-6\" data-attrs='{\"id\": 1, \"edge\": \"1 \\u2192 c\"}'/>\n<g opacity=\"0.4\"><line x1=\"171.3\" y1=\"123.7\" x2=\"187.1\" y2=\"107.9\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"2.46\" stroke-linecap=\"round\"/><polygon points=\"198.7,96.3 190.7,111.5 183.5,104.3\" fill=\"var(--ect-e5dfd507)\"/></g>\n<line x1=\"171.3\" y1=\"123.7\" x2=\"198.7\" y2=\"96.3\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"8-9-7\" data-attrs='{\"id\": 10, \"edge\": \"o \\u2192 w\"}'/>\n<g opacity=\"0.4\"><line x1=\"171.3\" y1=\"196.3\" x2=\"187.1\" y2=\"212.1\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"2.46\" stroke-linecap=\"round\"/><polygon points=\"198.7,223.7 183.5,215.7 190.7,208.5\" fill=\"var(--ect-e5dfd507)\"/></g>\n<line x1=\"171.3\" y1=\"196.3\" x2=\"198.7\" y2=\"223.7\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"4-5-8\" data-attrs='{\"id\": 3, \"edge\": \"a \\u2192 t\"}'/>\n<g opacity=\"0.4\"><line x1=\"176.0\" y1=\"185.0\" x2=\"177.6\" y2=\"185.0\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"2.46\" stroke-linecap=\"round\"/><polygon points=\"194.0,185.0 177.6,190.1 177.6,179.9\" fill=\"var(--ect-e5dfd507)\"/></g>\n<line x1=\"176.0\" y1=\"185.0\" x2=\"194.0\" y2=\"185.0\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"4-6-9\" data-attrs='{\"id\": 5, \"edge\": \"a \\u2192 r\"}'/>\n<g opacity=\"0.4\"><line x1=\"171.3\" y1=\"173.7\" x2=\"187.1\" y2=\"157.9\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"2.46\" stroke-linecap=\"round\"/><polygon points=\"198.7,146.3 190.7,161.5 183.5,154.3\" fill=\"var(--ect-e5dfd507)\"/></g>\n<line x1=\"171.3\" y1=\"173.7\" x2=\"198.7\" y2=\"146.3\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"4-7-10\" data-attrs='{\"id\": 7, \"edge\": \"a \\u2192