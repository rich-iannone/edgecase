ily=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"10.1\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">10</text>\n<text x=\"247.0\" y=\"270.1\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"10.1\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">12</text>\n<text x=\"69.2\" y=\"211.5\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"10.1\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">8</text>\n</svg>\n<div id=\"ec-tooltip-1\" style=\"\n  display:none;position:absolute;padding:6px 10px;border-radius:6px;\n  font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:12px;pointer-events:none;\n  background:var(--ect-57425a7e);color:var(--ect-21ade003);\n  box-shadow:0 2px 8px rgba(0,0,0,0.18);max-width:min(260px,100%);box-sizing:border-box;\n  z-index:999;line-height:1.4;overflow-wrap:anywhere;\n\"></div>\n<script>\n(function(){\n  var tip=document.currentScript.parentElement.querySelector('#ec-tooltip-1');\n  var svg=document.currentScript.parentElement.querySelector('svg');\n  if(!svg||!tip) return;\n  // Next to the pointer but inside the plot (flipped to the pointer's left near the right edge),\n  // since anything past its edges is clipped, and scrolls, in a notebook or Quarto cell\n  function place(ev){\n    var r=svg.getBoundingClientRect();\n    var x=ev.clientX-r.left+12,y=ev.clientY-r.top-10;\n    if(x+tip.offsetWidth>r.width) x=ev.clientX-r.left-12-tip.offsetWidth;\n    tip.style.left=Math.max(0,Math.min(x,r.width-tip.offsetWidth))+'px';\n    tip.style.top=Math.max(0,Math.min(y,r.height-tip.offsetHeight))+'px';\n  }\n  function show(el,ev){\n    var raw=el.getAttribute('data-attrs');\n    if(!raw) return;\n    try{var d=JSON.parse(raw)}catch(e){return}\n    var h='';\n    for(var k in d){\n      var v=d[k];\n      if(Array.isArray(v)) v=v.join(', ');\n      h+='<div><b>'+k+'</b>: '+v+'</div>';\n    }\n    if(!h) return;\n    tip.innerHTML=h;tip.style.display='block';\n    place(ev);\n  }\n  svg.addEventListener('mouseover',function(ev){\n    var t=ev.target;\n    if(t.hasAttribute('data-node')||t.hasAttribute('data-edge')) show(t,ev);\n  });\n  svg.addEventListener('mousemove',function(ev){\n    if(tip.style.display==='block') place(ev);\n  });\n  svg.addEventListener('mouseout',function(ev){\n    var t=ev.target;\n    if(t.hasAttribute('data-node')||t.hasAttribute('data-edge'))\n      tip.style.display='none';\n  });\n})();\n</script>\n</div></div>\n```\n:::\n:::\n\n\n::: {#05a7fda2 .cell execution_count=6}\n``` {.python .cell-code}\npurine.plot(\n    color_by=\"element\", label_by=\"canonical\", legend=False, seed=4,\n    width=360, height=360,\n)\n```\n\n::: {.cell-output .cell-output-display execution_count=6}\n```{=html}\n<div class=\"ec-theme\" style=\"display:contents\"><style class=\"ec-theme-vars\">:where(.ec-theme){--ect-3239c383:#fafafa;--ect-e5dfd507:#94a3b8;--ect-8a2de1d4:#374151;--ect-57425a7e:rgba(15,23,42,0.88);--ect-21ade003:#f1f5f9;--ect-61169ea5:#c2410c;--ect-f59ba8df:#a1a1aa}@media (prefers-color-scheme: dark){.ec-theme{--ect-3239c383:#0d1117;--ect-e5dfd507:#4b5563;--ect-8a2de1d4:#d1d5db;--ect-57425a7e:rgba(241,245,249,0.92);--ect-21ade003:#0f172a;--ect-61169ea5:#f97316;--ect-f59ba8df:#71717a}}:is(html.quarto-light, body.quarto-light, html[data-bs-theme=\"light\"], [data-jp-theme-light=\"true\"], body.vscode-light, body.vscode-high-contrast-light, html[theme=\"light\"]) .ec-theme{--ect-3239c383:#fafafa;--ect-e5dfd507:#94a3b8;--ect-8a2de1d4:#374151;--ect-57425a7e:rgba(15,23,42,0.88);--ect-21ade003:#f1f5f9;--ect-61169ea5:#c2410c;--ect-f59ba8df:#a1a1aa}:is(html.quarto-dark, body.quarto-dark, html[data-bs-theme=\"dark\"], [data-jp-theme-light=\"false\"], body.vscode-dark, body.vscode-hi