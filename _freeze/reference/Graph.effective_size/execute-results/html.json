 { display:block; max-width:100%; height:auto; }</style>\n<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"700\" height=\"500\" viewBox=\"5.5 -30.3 820.0 585.7\" style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;\">\n<rect x=\"5.5\" y=\"-30.3\" width=\"820.0\" height=\"585.7\" fill=\"var(--ect-3239c383)\"/>\n<line x1=\"632.4\" y1=\"420.4\" x2=\"540.9\" y2=\"391.0\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"2.1\" stroke-opacity=\"0.4\" stroke-linecap=\"round\"/>\n<line x1=\"632.4\" y1=\"420.4\" x2=\"540.9\" y2=\"391.0\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"11-10-0\" data-attrs='{\"id\": 10, \"edge\": \"Salviati \\u2014 Pazzi\", \"rel\": \"marriage\"}'/>\n<line x1=\"129.6\" y1=\"421.5\" x2=\"68.6\" y2=\"368.7\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"2.1\" stroke-opacity=\"0.4\" stroke-linecap=\"round\"/>\n<line x1=\"129.6\" y1=\"421.5\" x2=\"68.6\" y2=\"368.7\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"3-4-1\" data-attrs='{\"id\": 2, \"edge\": \"Castellani \\u2014 Peruzzi\", \"rel\": \"marriage\"}'/>\n<line x1=\"141.3\" y1=\"416.4\" x2=\"143.4\" y2=\"353.2\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"2.1\" stroke-opacity=\"0.4\" stroke-linecap=\"round\"/>\n<line x1=\"141.3\" y1=\"416.4\" x2=\"143.4\" y2=\"353.2\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"3-5-2\" data-attrs='{\"id\": 3, \"edge\": \"Castellani \\u2014 Strozzi\", \"rel\": \"marriage\"}'/>\n<line x1=\"155.7\" y1=\"431.7\" x2=\"259.5\" y2=\"435.0\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"2.1\" stroke-opacity=\"0.4\" stroke-linecap=\"round\"/>\n<line x1=\"155.7\" y1=\"431.7\" x2=\"259.5\" y2=\"435.0\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"3-6-3\" data-attrs='{\"id\": 4, \"edge\": \"Castellani \\u2014 Barb