ll=\"none\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"1.2892559366754617\" stroke-linecap=\"round\"/><polygon points=\"580.7,182.3 575.6,189.8 572.3,185.5\" fill=\"var(--ect-e5dfd507)\"/></g>\n<path d=\"M 526.2 209.9 Q 556.2 201.6 580.7 182.3\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"2-3-4\" data-attrs='{\"id\": 3, \"edge\": \"Dee \\u2192 Eve\", \"weight\": 80.0}'/>\n<g opacity=\"0.4\"><line x1=\"524.2\" y1=\"222.7\" x2=\"619.3\" y2=\"283.2\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"1.2807451187335093\" stroke-linecap=\"round\"/><polygon points=\"626.5,287.8 617.9,285.5 620.7,281.0\" fill=\"var(--ect-e5dfd507)\"/></g>\n<line x1=\"524.2\" y1=\"222.7\" x2=\"626.5\" y2=\"287.8\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"2-4-5\" data-attrs='{\"id\": 5, \"edge\": \"Dee \\u2192 Grocer\", \"weight\": 64.0}'/>\n<g opacity=\"0.4\"><line x1=\"339.9\" y1=\"287.2\" x2=\"488.0\" y2=\"223.9\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"1.310532981530343\" stroke-linecap=\"round\"/><polygon points=\"496.0,220.4 489.1,226.4 486.9,221.4\" fill=\"var(--ect-e5dfd507)\"/></g>\n<line x1=\"339.9\" y1=\"287.2\" x2=\"496.0\" y2=\"220.4\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"5-2-6\" data-attrs='{\"id\": 6, \"edge\": \"Ana \\u2192 Dee\", \"weight\": 120.0}'/>\n<g opacity=\"0.4\"><line x1=\"309.8\" y1=\"289.0\" x2=\"268.5\" y2=\"277.0\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"6.3\" stroke-linecap=\"round\"/><polygon points=\"228.2,265.2 272.2,264.4 264.8,289.6\" fill=\"var(--ect-e5dfd507)\"/></g>\n<line x1=\"309.8\" y1=\"289.0\" x2=\"228.2\" y2=\"265.2\" fill=\"none\" stroke=\"transparent\" stroke-width=\"10.3\" pointer-events=\"stroke\" data-edge=\"5-6-7\" data-attrs='{\"id\": 7, \"edge\": \"Ana \\u2192 Ben\", \"weight\": 9500.0}'/>\n<g opacity=\"0.4\"><line x1=\"552.8\" y1=\"91.3\" x2=\"521.6\" y2=\"182.4\" 