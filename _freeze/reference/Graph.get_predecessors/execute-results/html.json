ine x1=\"512.7\" y1=\"180.7\" x2=\"419.3\" y2=\"87.3\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"10-12-11\" data-attrs='{\"id\": 16, \"edge\": \"CS360 \\u2192 CS460\"}'/>\n<g opacity=\"0.2\"><line x1=\"220.7\" y1=\"415.1\" x2=\"84.3\" y2=\"324.2\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"1.98\" stroke-linecap=\"round\"/><polygon points=\"73.3,316.9 86.6,320.8 82.0,327.6\" fill=\"var(--ect-e5dfd507)\"/></g>\n<line x1=\"220.7\" y1=\"415.1\" x2=\"73.3\" y2=\"316.9\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"2-3-12\" data-attrs='{\"id\": 3, \"edge\": \"CS102 \\u2192 CS201\"}'/>\n<g opacity=\"0.2\"><line x1=\"226.8\" y1=\"409.7\" x2=\"189.1\" y2=\"334.1\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"1.98\" stroke-linecap=\"round\"/><polygon points=\"183.2,322.3 192.7,332.3 185.4,336.0\" fill=\"var(--ect-e5dfd507)\"/></g>\n<line x1=\"226.8\" y1=\"409.7\" x2=\"183.2\" y2=\"322.3\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"2-4-13\" data-attrs='{\"id\": 5, \"edge\": \"CS102 \\u2192 CS210\"}'/>\n<g opacity=\"0.2\"><line x1=\"241.2\" y1=\"409.7\" x2=\"278.9\" y2=\"334.1\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"1.98\" stroke-linecap=\"round\"/><polygon points=\"284.8,322.3 282.6,336.0 275.3,332.3\" fill=\"var(--ect-e5dfd507)\"/></g>\n<line x1=\"241.2\" y1=\"409.7\" x2=\"284.8\" y2=\"322.3\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"2-5-14\" data-attrs='{\"id\": 6, \"edge\": \"CS102 \\u2192 CS220\"}'/>\n<g opacity=\"0.2\"><line x1=\"247.3\" y1=\"415.1\" x2=\"383.7\" y2=\"324.2\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"1.98\" stroke-linecap=\"round\"/><polygon points=\"394.7,316.9 386.0,327.6 381.4,320.8\" fill=\"var(--ect-e5dfd507)\"/></g>\n<line x1=\"247.3\" y1=\"415.1\" x2=\"394.7\" y2=\"316.9\" fill=\"none\" stroke=\"transparent\" stroke-width=\