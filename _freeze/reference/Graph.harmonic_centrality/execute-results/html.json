ly=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">Lakeside</text>\n<text x=\"357.6\" y=\"241.2\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">Opera</text>\n<text x=\"312.0\" y=\"226.0\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">Museum</text>\n<text x=\"190.4\" y=\"286.8\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">Mill Lane</text>\n<text x=\"257.3\" y=\"469.2\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">Docks</text>\n<text x=\"372.8\" y=\"286.8\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">Market</text>\n<text x=\"448.8\" y=\"150.0\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">Garden</text>\n<text x=\"312.0\" y=\"89.2\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">Northpark</text>\n<text x=\"509.6\" y=\"362.8\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">Business Park</text>\n<g class=\"ec-legend\" transform=\"translate(637.0 7.9) scale(1.0083)\"><text x=\"0.0\" y=\"12.0\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"var(--ect-8a2de1d4)\" dominant-baseline=\"middle\">harmonic_centrality</text><defs><linearGradient id=\"ec-ramp-05a37ca5\" x1=\"0\" y1=\"1\" x2=\"0\" y2=\"0\"><stop offset=\"0\" stop-color=\"var(--ect-975840b8)\"/><stop offset=\"0.1\" stop-color=\"var(--ect-f8094ac6)\"/><stop offset=\"0.2\" stop-color=\"var(--ect-472663e1)\"/><stop offset=\"0.3\" stop-color=\"var(--ect-6826a5f9)\"/><stop offset=\"0.4\" stop-color=\"var(--ect-9d43aea2)\"/><stop offset=\"0.5\" stop-color=\"var(--ect-5ee57d66)\"/><stop offset=\"0.6\" stop-color=\"var(--ect-3c980f0e)\"/><stop offset=\"0.7\" stop-color=\"var(--ect-ec386ef0)\"/><stop offset=\"0.8\" stop-color=\"var(--ect-97f76ec5)\"/><stop offset=\"0.9\" stop-color=\"var(--ect-e28c6970)\"/><stop offset=\"1\" stop-color=\"var(--ect-6425850a)\"/></linearGradient></defs><rect x=\"2\" y=\"23.5\" width=\"10\" height=\"90\" rx=\"2\" fill=\"url(#ec-ramp-05a37ca5)\"/><text x=\"22.0\" y=\"23.5\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11\" fill=\"var(--ect-8a2de1d4)\" dominant-baseline=\"middle\">4.22</text><text x=\"22.0\" y=\"113.5\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11\" fill=\"var(--ect-8a2de1d4)\" dominant-baseline=\"middle\">1.3</text></g>\n</svg>\n<div id=\"ec-tooltip-1\" style=\"\n  display:none;position:absolute;padding:6px 10px;border-radius:6px;\n  font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:12px;pointer-events:none;\n  background:var(--ect-57425a7e);color:var(--ect-21ade003);\n  box-shadow:0 2px 8px rgba(0,0,0,0.18);max-width:min(260px,100%);box-sizing:border-box;\n  z-index:999;line-height:1.4;overflow-wrap:anywhere;\n\"></div>\n<script>\n(function(){\n  var tip=document.currentScript.parentElement.querySelector('#ec-tooltip-1');\n  var svg=document.currentScript.parentElement.querySelector('svg');\n  if(!svg||!tip) return;\n  // Next to the pointer but inside the plot (flipped to the pointer's left near the right edge),\n  // since anything past its edges is clipped, and scrolls, in a notebook or Quarto cell\n  function place(ev){\n    var r=svg.getBoundingClientRect();\n    var x=ev.clientX-r.left+12,y=ev.clientY-r.top-10;\n    if(x+tip.offsetWidth>r.width) x=ev.clientX-r.left-12-tip.offsetWidth;\n    tip.style.left=Math.max(0,Math.min(x,r.width-tip.offsetWidth))+'px';\n    tip.style.top=Math.max(0,Math.min(y,r.height-tip.offsetHeight))+'px';\n  }\n  function show(el,ev){\n    var raw=el.getAttribute('data-attrs');\n    if(!raw) return;\n    try{var d=JSON.parse(raw)}catch(e){return}\n    var h='';\n    for(var k in d){\n      var v=d[k];\n      if(Array.isArray(v)) v=v.join(', ');\n      h+='<div><b>'+k+'</b>: '+v+'</div>';\n    }\n    if(!h) return;\n    tip.innerHTML=h;tip.style.display='block';\n    place(ev);\n  }\n  svg.addEventListener('mouseover',function(ev){\n    var t=ev.target;\n    if(t.hasAttribute('data-node')||t.hasAttribute('data-edge')) show(t,ev);\n  });\n  svg.addEventListener('mousemove',function(ev){\n    if(tip.style.display==='block') place(ev);\n  });\n  svg.addEventListener('mouseout',function(ev){\n    var t=ev.target;\n    if(t.hasAttribute('data-node')||t.hasAttribute('data-edge'))\n      tip.style.display='none';\n  });\n})();\n</script>\n</div></div>\n```\n:::\n:::\n\n\n### When the line is cut\n\nHarmonic centrality copes with a disconnected graph, since an unreachable station only\nadds `0`. With the Riverside-Harbor link closed, Harbor, Docks and Shipyard are cut off.\nCloseness computed only over the stations each one can reach (`wf_improved=False`) puts\nHarbor first, two short hops from its two neighbors; harmonic centrality puts the three\nlast:\n\n::: {#328c3779 .cell execution_count=3}\n``` {.python .cell-code}\nimport polars as pl\n\ncut = (\n    ec.metro()\n    .delete_edge(\"Riverside\", \"Harbor\")\n    .harmonic_centrality()\n    .closeness_centrality(wf_improved=False)\n)\n\n(\n    cut.get_node_df()\n    .with_columns(\n        pl.col(\"harmonic_centrality\", \"closeness_centrality\")\n        .rank(\"min\", descending=True)\n        .name.suffix(\"_rank\")\n    )\n    .filter(pl.col(\"label\").is_in([\"Central\", \"Market\", \"Harbor\", \"Docks\"]))\n    .select(\n        \"label\", \"harmonic_centrality_rank\", \"closeness_centrality_rank\"\n    )\n)\n```\n\n::: {.cell-output .cell-output-display execution_count=3}\n```{=html}\n<div><style>\n.dataframe > thead > tr,\n.dataframe > tbody > tr {\n  text-align: right;\n  white-space: pre-wrap;\n}\n</style>\n<small>shape: (4, 3)</small><table border=\"1\" class=\"dataframe\"><thead><tr><th>label</th><th>harmonic_centrality_rank</th><th>closeness_centrality_rank</th></tr><tr><td>str</td><td>u32</td><td>u32</td></tr></thead><tbody><tr><td>&quot;Central&quot;</td><td>1</td><td>4</td></tr><tr><td>&quot;Market&quot;</td><td>3</td><td>5</td></tr><tr><td>&quot;Harbor&quot;</td><td>18</td><td>1</td></tr><tr><td>&quot;Docks&quot;</td><td>19</td><td>2</td></tr></tbody></table></div>\n```\n:::\n:::\n\n\nThe default `closeness_centrality()` corrects for this by scaling each score by the share\nof the graph a node can reach. To count only nearby nodes, pass `cutoff=` a maximum\ndistance.\n\n",
