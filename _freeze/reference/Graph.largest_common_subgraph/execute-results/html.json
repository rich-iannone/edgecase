\": \"single\"}'/>\n<line x1=\"253.5\" y1=\"219.4\" x2=\"167.6\" y2=\"172.2\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"2.16\" stroke-opacity=\"0.2\" stroke-linecap=\"round\"/>\n<line x1=\"253.5\" y1=\"219.4\" x2=\"167.6\" y2=\"172.2\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"6-2-10\" data-attrs='{\"id\": 6, \"edge\": \"C4 \\u2014 N1\", \"bond\": \"single\"}'/>\n<line x1=\"137.6\" y1=\"163.3\" x2=\"76.2\" y2=\"158.7\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"2.16\" stroke-opacity=\"0.2\" stroke-linecap=\"round\"/>\n<line x1=\"137.6\" y1=\"163.3\" x2=\"76.2\" y2=\"158.7\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"2-1-11\" data-attrs='{\"id\": 1, \"edge\": \"C1 \\u2014 N1\", \"bond\": \"single\"}'/>\n<line x1=\"536.0\" y1=\"102.8\" x2=\"489.9\" y2=\"149.0\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"2.16\" stroke-opacity=\"0.2\" stroke-linecap=\"round\"/>\n<line x1=\"536.0\" y1=\"102.8\" x2=\"489.9\" y2=\"149.0\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"13-12-12\" data-attrs='{\"id\": 14, \"edge\": \"N4 \\u2014 C7\", \"bond\": \"single\"}'/>\n<line x1=\"331.8\" y1=\"129.5\" x2=\"277.5\" y2=\"71.7\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"2.16\" stroke-opacity=\"0.2\" stroke-linecap=\"round\"/>\n<line x1=\"331.8\" y1=\"129.5\" x2=\"277.5\" y2=\"71.7\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"5-4-13\" data-attrs='{\"id\": 4, \"edge\": \"N2 \\u2014 C3\", \"bond\": \"single\"}'/>\n<line x1=\"358.6\" y1=\"143.4\" x2=\"462.8\" y2=\"158.1\" stroke=\"var(--ect-e5dfd507)\" stroke-width=\"2.16\" stroke-opacity=\"0.2\" stroke-linecap=\"round\"/>\n<line x1=\"358.6\" y1=\"143.4\" x2=\"462.8\" y2=\"158.1\" fill=\"none\" stroke=\"transparent\" stroke-width=\"8.0\" pointer-events=\"stroke\" data-edge=\"5-12-14\" data-attrs='{\"id\": 13, \"edge\": \"N4