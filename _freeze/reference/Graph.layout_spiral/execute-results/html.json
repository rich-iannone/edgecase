play:none;position:absolute;padding:6px 10px;border-radius:6px;\n  font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:12px;pointer-events:none;\n  background:rgba(15,23,42,0.88);color:#f1f5f9;\n  box-shadow:0 2px 8px rgba(0,0,0,0.18);max-width:260px;z-index:999;\n  line-height:1.4;\n\"></div>\n<script>\n(function(){\n  var tip=document.currentScript.parentElement.querySelector('#ec-tooltip-1');\n  var svg=document.currentScript.parentElement.querySelector('svg');\n  if(!svg||!tip) return;\n  function show(el,ev){\n    var raw=el.getAttribute('data-attrs');\n    if(!raw) return;\n    try{var d=JSON.parse(raw)}catch(e){return}\n    var h='';\n    for(var k in d){\n      var v=d[k];\n      if(typeof v==='number'&&!Number.isInteger(v)) v=v.toFixed(4);\n      h+='<div><b>'+k+'</b>: '+v+'</div>';\n    }\n    if(!h) return;\n    tip.innerHTML=h;tip.style.display='block';\n    var r=svg.getBoundingClientRect();\n    tip.style.left=(ev.clientX-r.left+12)+'px';\n    tip.style.top=(ev.clientY-r.top-10)+'px';\n  }\n  svg.addEventListener('mouseover',function(ev){\n    var t=ev.target;\n    if(t.hasAttribute('data-node')||t.hasAttribute('data-edge')) show(t,ev);\n  });\n  svg.addEventListener('mousemove',function(ev){\n    var r=svg.getBoundingClientRect();\n    tip.style.left=(ev.clientX-r.left+12)+'px';\n    tip.style.top=(ev.clientY-r.top-10)+'px';\n  });\n  svg.addEventListener('mouseout',function(ev){\n    var t=ev.target;\n    if(t.hasAttribute('data-node')||t.hasAttribute('data-edge'))\n      tip.style.display='none';\n  });\n})();\n</script>\n</div>\n```\n:::\n:::\n\n\n",
