rict\", \"pos\": [5.0, 1.0]}' />\n<circle cx=\"350.0\" cy=\"60.0\" r=\"16.0\" fill=\"#4e79a7\" stroke=\"#365474\" stroke-width=\"1.5\" stroke-opacity=\"0.3\" data-node=\"5\" data-attrs='{\"id\": \"5\", \"label\": \"West Plant\", \"kind\": \"plant\", \"pos\": [3.0, 1.0]}' />\n<circle cx=\"92.9\" cy=\"145.7\" r=\"16.0\" fill=\"#4e79a7\" stroke=\"#365474\" stroke-width=\"1.5\" stroke-opacity=\"0.3\" data-node=\"1\" data-attrs='{\"id\": \"1\", \"label\": \"Reservoir\", \"kind\": \"source\", \"pos\": [0.0, 0.0]}' />\n<circle cx=\"435.7\" cy=\"231.4\" r=\"16.0\" fill=\"#4e79a7\" stroke=\"#365474\" stroke-width=\"1.5\" stroke-opacity=\"0.3\" data-node=\"8\" data-attrs='{\"id\": \"8\", \"label\": \"Ridge Tank\", \"kind\": \"tank\", \"pos\": [4.0, -1.0]}' />\n<circle cx=\"264.3\" cy=\"300.0\" r=\"16.0\" fill=\"#4e79a7\" stroke=\"#365474\" stroke-width=\"1.5\" stroke-opacity=\"0.3\" data-node=\"4\" data-attrs='{\"id\": \"4\", \"label\": \"Hill Pump\", \"kind\": \"pump\", \"pos\": [2.0, -1.8]}' />\n<text x=\"607.1\" y=\"174.9\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">City</text>\n<text x=\"435.7\" y=\"89.2\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">Valley Junction</text>\n<text x=\"178.6\" y=\"260.6\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">South Intake</text>\n<text x=\"521.4\" y=\"260.6\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">South District</text>\n<text x=\"350.0\" y=\"260.6\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">East Plant</text>\n<text x=\"178.6\" y=\"89.2\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">North Intake</text>\n<text x=\"521.4\" y=\"89.2\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">North District</text>\n<text x=\"350.0\" y=\"89.2\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">West Plant</text>\n<text x=\"92.9\" y=\"174.9\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">Reservoir</text>\n<text x=\"435.7\" y=\"260.6\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">Ridge Tank</text>\n<text x=\"264.3\" y=\"329.2\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">Hill Pump</text>\n</svg>\n<div id=\"ec-tooltip-1\" style=\"\n  display:none;position:absolute;padding:6px 10px;border-radius:6px;\n  font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:12px;pointer-events:none;\n  background:var(--ect-57425a7e);color:var(--ect-21ade003);\n  box-shadow:0 2px 8px rgba(0,0,0,0.18);max-width:min(260px,100%);box-sizing:border-box;\n  z-index:999;line-height:1.4;overflow-wrap:anywhere;\n\"></div>\n<script>\n(function(){\n  var tip=document.currentScript.parentElement.querySelector('#ec-tooltip-1');\n  var svg=document.currentScript.parentElement.querySelector('svg');\n  if(!svg||!tip) return;\n  // Next to the pointer but inside the plot (flipped to the pointer's left near the right edge),\n  // since anything past its edges is clipped, and scrolls, in a notebook or Quarto cell\n  function place(ev){\n    var r=svg.getBoundingClientRect();\n    var x=ev.clientX-r.left+12,y=ev.clientY-r.top-10;\n    if(x+tip.offsetWidth>r.width) x=ev.clientX-r.left-12-tip.offsetWidth;\n    tip.style.left=Math.max(0,Math.min(x,r.width-tip.offsetWidth))+'px';\n    tip.style.top=Math.max(0,Math.min(y,r.height-tip.offsetHeight))+'px';\n  }\n  function show(el,ev){\n    var raw=el.getAttribute('data-attrs');\n    if(!raw) return;\n    try{var d=JSON.parse(raw)}catch(e){return}\n    var h='';\n    for(var k in d){\n      var v=d[k];\n      if(Array.isArray(v)) v=v.join(', ');\n      h+='<div><b>'+k+'</b>: '+v+'</div>';\n    }\n    if(!h) return;\n    tip.innerHTML=h;tip.style.display='block';\n    place(ev);\n  }\n  svg.addEventListener('mouseover',function(ev){\n    var t=ev.target;\n    if(t.hasAttribute('data-node')||t.hasAttribute('data-edge')) show(t,ev);\n  });\n  svg.addEventListener('mousemove',function(ev){\n    if(tip.style.display==='block') place(ev);\n  });\n  svg.addEventListener('mouseout',function(ev){\n    var t=ev.target;\n    if(t.hasAttribute('data-node')||t.hasAttribute('data-edge'))\n      tip.style.display='none';\n  });\n})();\n</script>\n</div></div>\n```\n:::\n:::\n\n\nThe total is 45 ML a day, the 25 and 20 that arrive at the city. Several pipes run full,\nbut only two are the real limit: the pipes across the valley, from West Plant to Valley\nJunction and from East Plant to Ridge Tank. Every route to the city crosses one of them,\nand together they carry 45, so they form the minimum cut:\n\n::: {#5fafc607 .cell execution_count=3}\n``` {.python .cell-code}\ncut = pipeline.minimum_edge_cut(\"Reservoir\", \"City\", capacity=\"capacity\")\n\nlabel = pipeline.get_label_from_id\nsorted((label(u), label(v)) for u, v in cut)\n```\n\n::: {.cell-output .cell-output-display execution_count=3}\n```\n[('East Plant', 'Ridge Tank'), ('West Plant', 'Valley Junction')]\n```\n:::\n:::\n\n\n### Which upgrade helps\n\nThe cut says where new capacity pays off. Adding 10 ML a day to the North Intake pipe,\nwhich has room to spare, changes nothing, while adding the same to the West Plant pipe\nacross the valley raises the total to 55:\n\n::: {#3f12d86b .cell execution_count=4}\n``` {.python .cell-code}\ndef with_capacity(source, target, value):\n    return ec.pipeline().set_edge_attrs(\n        \"capacity\", value, edges=[(source, target)]\n    )\n\n(\n    with_capacity(\"North Intake\", \"West Plant\", 50)\n    .maximum_flow_value(\"Reservoir\", \"City\"),\n    with_capacity(\"West Plant\", \"Valley Junction\", 35)\n    .maximum_flow_value(\"Reservoir\", \"City\"),\n)\n```\n\n::: {.cell-output .cell-output-display execution_count=4}\n```\n(45.0, 55.0)\n```\n:::\n:::\n\n\nWhen only the total matters, `maximum_flow_value()` is quicker to read, and when pipes have\na running cost, `minimum_cost_flow()` finds the cheapest way to deliver a given amount.\n\n",
