roke-width=\"1.5\" stroke-opacity=\"0.3\" data-node=\"4\" data-attrs='{\"id\": \"4\", \"label\": \"negate\", \"code\": \"x = -x\", \"pos\": [3.0, 4.0]}' />\n<text x=\"598.1\" y=\"384.8\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">exit</text>\n<text x=\"439.7\" y=\"194.8\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">break</text>\n<text x=\"228.6\" y=\"194.8\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">sign test</text>\n<text x=\"545.3\" y=\"300.3\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">return mean</text>\n<text x=\"386.9\" y=\"268.6\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">limit test</text>\n<text x=\"175.8\" y=\"300.3\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">loop</text>\n<text x=\"545.3\" y=\"469.2\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">return None</text>\n<text x=\"334.2\" y=\"194.8\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">add</text>\n<text x=\"101.9\" y=\"300.3\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">entry</text>\n<text x=\"492.5\" y=\"384.8\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">empty test</text>\n<text x=\"281.4\" y=\"89.2\" text-anchor=\"middle\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\" font-size=\"11.2\" fill=\"var(--ect-8a2de1d4)\" pointer-events=\"none\">negate</text>\n</svg>\n<div id=\"ec-tooltip-1\" style=\"\n  display:none;position:absolute;padding:6px 10px;border-radius:6px;\n  font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:12px;pointer-events:none;\n  background:var(--ect-57425a7e);color:var(--ect-21ade003);\n  box-shadow:0 2px 8px rgba(0,0,0,0.18);max-width:min(260px,100%);box-sizing:border-box;\n  z-index:999;line-height:1.4;overflow-wrap:anywhere;\n\"></div>\n<script>\n(function(){\n  var tip=document.currentScript.parentElement.querySelector('#ec-tooltip-1');\n  var svg=document.currentScript.parentElement.querySelector('svg');\n  if(!svg||!tip) return;\n  // Next to the pointer but inside the plot (flipped to the pointer's left near the right edge),\n  // since anything past its edges is clipped, and scrolls, in a notebook or Quarto cell\n  function place(ev){\n    var r=svg.getBoundingClientRect();\n    var x=ev.clientX-r.left+12,y=ev.clientY-r.top-10;\n    if(x+tip.offsetWidth>r.width) x=ev.clientX-r.left-12-tip.offsetWidth;\n    tip.style.left=Math.max(0,Math.min(x,r.width-tip.offsetWidth))+'px';\n    tip.style.top=Math.max(0,Math.min(y,r.height-tip.offsetHeight))+'px';\n  }\n  function show(el,ev){\n    var raw=el.getAttribute('data-attrs');\n    if(!raw) return;\n    try{var d=JSON.parse(raw)}catch(e){return}\n    var h='';\n    for(var k in d){\n      var v=d[k];\n      if(Array.isArray(v)) v=v.join(', ');\n      h+='<div><b>'+k+'</b>: '+v+'</div>';\n    }\n    if(!h) return;\n    tip.innerHTML=h;tip.style.display='block';\n    place(ev);\n  }\n  svg.addEventListener('mouseover',function(ev){\n    var t=ev.target;\n    if(t.hasAttribute('data-node')||t.hasAttribute('data-edge')) show(t,ev);\n  });\n  svg.addEventListener('mousemove',function(ev){\n    if(tip.style.display==='block') place(ev);\n  });\n  svg.addEventListener('mouseout',function(ev){\n    var t=ev.target;\n    if(t.hasAttribute('data-node')||t.hasAttribute('data-edge'))\n      tip.style.display='none';\n  });\n})();\n</script>\n</div></div>\n```\n:::\n:::\n\n\nThe code of each block:\n\n::: {#796c03d4 .cell execution_count=2}\n``` {.python .cell-code}\ncfg.get_node_df().select(\"label\", \"code\")\n```\n\n::: {.cell-output .cell-output-display execution_count=2}\n```{=html}\n<div><style>\n.dataframe > thead > tr,\n.dataframe > tbody > tr {\n  text-align: right;\n  white-space: pre-wrap;\n}\n</style>\n<small>shape: (11, 2)</small><table border=\"1\" class=\"dataframe\"><thead><tr><th>label</th><th>code</th></tr><tr><td>str</td><td>str</td></tr></thead><tbody><tr><td>&quot;entry&quot;</td><td>&quot;total, n = 0, 0&quot;</td></tr><tr><td>&quot;loop&quot;</td><td>&quot;for x in values:&quot;</td></tr><tr><td>&quot;sign test&quot;</td><td>&quot;if x &lt; 0:&quot;</td></tr><tr><td>&quot;negate&quot;</td><td>&quot;x = -x&quot;</td></tr><tr><td>&quot;add&quot;</td><td>&quot;total += x\nn += 1&quot;</td></tr><tr><td>&hellip;</td><td>&hellip;</td></tr><tr><td>&quot;break&quot;</td><td>&quot;break&quot;</td></tr><tr><td>&quot;empty test&quot;</td><td>&quot;if n == 0:&quot;</td></tr><tr><td